{
  "name": "@perplexity-ai/perplexity_ai",
  "version": "0.37.0",
  "description": "The official TypeScript library for the Perplexity API",
  "author": "Perplexity <api@perplexity.ai>",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.js",
  "type": "commonjs",
  "repository": "github:perplexityai/perplexity-node",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.17.0",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "src"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bazel test //:test",
    "build": "bazel build //:pkg",
    "format": "lefthook run pre-commit --all-files",
    "prepare": "lefthook install",
    "lint": "bazel test //:lint",
    "fix": "pnpm format"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "iconv-lite": "^0.7.3",
    "lefthook": "^2.1.10",
    "mocha": "^11.7.6",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "publint": "^0.3.22",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "^9.0.5"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      }
    },
    "./*.mjs": {
      "default": "./dist/esm/*.js"
    },
    "./*.js": {
      "default": "./dist/cjs/*.js"
    },
    "./*": {
      "import": {
        "types": "./dist/esm/*.d.ts",
        "default": "./dist/esm/*.js"
      },
      "require": {
        "types": "./dist/cjs/*.d.ts",
        "default": "./dist/cjs/*.js"
      }
    }
  }
}
